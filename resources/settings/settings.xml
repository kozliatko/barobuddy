<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.ShowSeconds" title="@Strings.SettingShowSeconds">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.ShowPressureGraph" title="@Strings.SettingShowGraph">
        <settingConfig type="boolean" />
    </setting>

    <setting propertyKey="@Properties.StormAlert" title="@Strings.SettingStormAlert">
        <settingConfig type="boolean" />
    </setting>

    <!-- The same scale the watch's built-in Storm Alert uses, so the banner
         and the system alert can be set to fire together. -->
    <setting propertyKey="@Properties.StormThresholdHpa" title="@Strings.SettingStormThreshold">
        <settingConfig type="list">
            <listEntry value="2">@Strings.StormThreshold2</listEntry>
            <listEntry value="3">@Strings.StormThreshold3</listEntry>
            <listEntry value="4">@Strings.StormThreshold4</listEntry>
            <listEntry value="5">@Strings.StormThreshold5</listEntry>
            <listEntry value="6">@Strings.StormThreshold6</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.PressureUnit" title="@Strings.SettingPressureUnit">
        <settingConfig type="list">
            <listEntry value="0">@Strings.UnitHpa</listEntry>
            <listEntry value="1">@Strings.UnitInHg</listEntry>
            <listEntry value="2">@Strings.UnitMmHg</listEntry>
        </settingConfig>
    </setting>

    <!-- The status row. The same list of fields three times, once per cell;
         the values are StatusField.FIELD_* and must match properties.xml. A
         cell set to "Off" is dropped and the remaining ones spread out. -->
    <setting propertyKey="@Properties.StatusFieldLeft" title="@Strings.SettingStatusFieldLeft">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FieldNone</listEntry>
            <listEntry value="1">@Strings.FieldHeartRate</listEntry>
            <listEntry value="2">@Strings.FieldSteps</listEntry>
            <listEntry value="3">@Strings.FieldBattery</listEntry>
            <listEntry value="4">@Strings.FieldCalories</listEntry>
            <listEntry value="5">@Strings.FieldDistance</listEntry>
            <listEntry value="6">@Strings.FieldFloors</listEntry>
            <listEntry value="7">@Strings.FieldNotifications</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.StatusFieldMiddle" title="@Strings.SettingStatusFieldMiddle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FieldNone</listEntry>
            <listEntry value="1">@Strings.FieldHeartRate</listEntry>
            <listEntry value="2">@Strings.FieldSteps</listEntry>
            <listEntry value="3">@Strings.FieldBattery</listEntry>
            <listEntry value="4">@Strings.FieldCalories</listEntry>
            <listEntry value="5">@Strings.FieldDistance</listEntry>
            <listEntry value="6">@Strings.FieldFloors</listEntry>
            <listEntry value="7">@Strings.FieldNotifications</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.StatusFieldRight" title="@Strings.SettingStatusFieldRight">
        <settingConfig type="list">
            <listEntry value="0">@Strings.FieldNone</listEntry>
            <listEntry value="1">@Strings.FieldHeartRate</listEntry>
            <listEntry value="2">@Strings.FieldSteps</listEntry>
            <listEntry value="3">@Strings.FieldBattery</listEntry>
            <listEntry value="4">@Strings.FieldCalories</listEntry>
            <listEntry value="5">@Strings.FieldDistance</listEntry>
            <listEntry value="6">@Strings.FieldFloors</listEntry>
            <listEntry value="7">@Strings.FieldNotifications</listEntry>
        </settingConfig>
    </setting>
</settings>
