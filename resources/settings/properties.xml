<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- Defaults must match AppSettings.DEFAULT_* so a device that has not yet
         synced its settings looks the same as one that has. -->
    <property id="ShowSeconds" type="boolean">true</property>
    <property id="ShowPressureGraph" type="boolean">true</property>
    <property id="StormAlert" type="boolean">true</property>

    <!-- Fall in hPa over three hours that raises the warning. Match it to the
         watch's own Storm Alert setting to have the two agree. -->
    <property id="StormThresholdHpa" type="number">3</property>

    <!-- 0 = hPa, 1 = inHg, 2 = mmHg. See PressureFormatter.UNIT_*. -->
    <property id="PressureUnit" type="number">0</property>

    <!-- The three cells of the status row, left to right. See
         StatusField.FIELD_*. The defaults are heart rate, steps and battery. -->
    <property id="StatusFieldLeft" type="number">1</property>
    <property id="StatusFieldMiddle" type="number">2</property>
    <property id="StatusFieldRight" type="number">3</property>
</properties>
